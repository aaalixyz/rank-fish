# Copy this file to `.env.local` and fill in real values.
# On Vercel, add the same keys under Project → Settings → Environment Variables.

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Polar.sh
POLAR_ACCESS_TOKEN=polar_oat_xxxxxxxx
POLAR_WEBHOOK_SECRET=polar_whs_xxxxxxxx
POLAR_PRODUCT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Use "sandbox" while testing, "production" when live
POLAR_SERVER=sandbox

# Public URL of this app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
